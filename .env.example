AI_SERVICE_NAME=zpantry-ai-service
AI_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8000

BACKEND_BASE_URL=http://backend:8080
# Required for receipt and food-image analysis. Keep the real value only in .env.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional; defaults to gemini-2.5-flash in the application.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated stable fallback order, for example primary,fallback.
GEMINI_MODELS=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_CONCURRENCY=5
GEMINI_QUEUE_TIMEOUT_MS=3000
GEMINI_CACHE_TTL_SECONDS=600

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-model
EMBEDDING_DIMENSION=1536

RECOMMENDATION_PROVIDER=mock
RECOMMENDATION_MODEL=mock-recommendation-model

LOG_LEVEL=INFO

